# ─────────────────────────────────────────────────────────────────────────────
# InterCode — фронтенд (React + Vite) → статика в nginx.
# Сборка:  docker build -f Dockerfile.vps -t intercode-web .
# Рантайм: образ содержит только nginx и собранный фронтенд.
# ─────────────────────────────────────────────────────────────────────────────

FROM node:20-alpine AS build
WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
ARG VITE_APP_NAME=IntQst
RUN npm run build

FROM nginx:1.27-alpine
# Конфиг с проксированием /api и /ws на контейнер сервера.
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
